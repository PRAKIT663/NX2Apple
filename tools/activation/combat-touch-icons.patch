+    [done addTarget:self action:@selector(finishTouchLayout) forControlEvents:UIControlEventTouchUpInside];
+    UIButton *reset = [UIButton buttonWithConfiguration:[UIButtonConfiguration tintedButtonConfiguration] primaryAction:nil];
+    [reset setTitle:@"Reset" forState:UIControlStateNormal];
+    [reset addTarget:self action:@selector(resetTouchLayout) forControlEvents:UIControlEventTouchUpInside];
+    UIStackView *bar = [[UIStackView alloc] initWithArrangedSubviews:@[reset, done]];
+    bar.spacing = 12;
+    bar.translatesAutoresizingMaskIntoConstraints = NO;
+    [_layoutEditor addSubview:bar];
+    [self addSubview:_layoutEditor];
+    [NSLayoutConstraint activateConstraints:@[
+        [bar.centerXAnchor constraintEqualToAnchor:_layoutEditor.centerXAnchor],
+        [bar.topAnchor constraintEqualToAnchor:_layoutEditor.safeAreaLayoutGuide.topAnchor constant:4]
