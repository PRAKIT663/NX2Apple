+- (void)resetTouchLayout {
+    NSArray *groups = @[@(kFaceGroup), @(kStickGroup), @(kDpadGroup)];
+    for (NSNumber *group in groups) [_customPositions removeObjectForKey:[self positionKey:group.integerValue]];
+    for (NSUInteger i = 0; i < sizeof k_btns / sizeof *k_btns; ++i)
