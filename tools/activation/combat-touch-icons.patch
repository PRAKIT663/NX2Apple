+- (void)editTouchLayout {
+    if (_layoutEditor || _tap || _padOff) return;
+    [self reset];
+    _layoutEditor = [[UIView alloc] initWithFrame:self.bounds];
+    _layoutEditor.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    [_layoutEditor addGestureRecognizer:[[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(dragControl:)]];
+    UIButton *done = [UIButton buttonWithConfiguration:[UIButtonConfiguration filledButtonConfiguration] primaryAction:nil];
