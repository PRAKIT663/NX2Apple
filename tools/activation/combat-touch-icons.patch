+static UIImage *combatButtonIcon(int button) {
+    NSString *symbol = nil;
+    UIColor *color = nil;
+    if (strcmp(DM_GAME_ID, "010035F022078000") == 0) {
+        // Standard preset, mapped by Nintendo button position.
+        static NSString *const symbols[B_N] = {
+            [B_Y] = @"fist", [B_X] = @"bolt.circle.fill",
+            [B_R] = @"shield.fill", [B_B] = @"forward.fill",
+        };
+        symbol = symbols[button];
+        color = [UIColor colorWithRed:1 green:0.66 blue:0.28 alpha:1];
+    } else if (strcmp(DM_GAME_ID, "0100AD80208A8000") == 0) {
+        static NSString *const symbols[B_N] = {
+            [B_Y] = @"blade", [B_X] = @"sparkles",
+            [B_R] = @"shield.fill", [B_A] = @"forward.fill",
+            [B_B] = @"arrow.up", [B_ZR] = @"flame.fill",
+        };
+        symbol = symbols[button];
+        color = [UIColor colorWithRed:0.46 green:0.92 blue:0.86 alpha:1];
+    }
+    if (!symbol) return nil;
+    BOOL fist = [symbol isEqualToString:@"fist"];
+    BOOL blade = [symbol isEqualToString:@"blade"];
+    UIImageSymbolConfiguration *config = [UIImageSymbolConfiguration
+        configurationWithPointSize:18 weight:UIImageSymbolWeightSemibold];
+    UIImage *image = [[UIImage systemImageNamed:symbol withConfiguration:config]
+        imageWithTintColor:color renderingMode:UIImageRenderingModeAlwaysOriginal];
+    if (!fist && !blade && !image) return nil;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(24, 24)];
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        [color setFill];
+        if (fist) {
+            for (int i = 0; i < 4; i++) {
+                CGRect finger = CGRectMake(4 + 4 * i, i == 1 ? 3 : 5, 3.7, 8);
+                [[UIBezierPath bezierPathWithRoundedRect:finger cornerRadius:1.5] fill];
+            }
+            [[UIBezierPath bezierPathWithRoundedRect:CGRectMake(4, 11, 16, 8) cornerRadius:3] fill];
+            [[UIBezierPath bezierPathWithRoundedRect:CGRectMake(8, 16, 9, 5) cornerRadius:1.5] fill];
+        } else if (blade) {
+            CGContextRef cg = context.CGContext;
+            CGContextTranslateCTM(cg, 12, 12);
+            CGContextRotateCTM(cg, M_PI_4);
+            UIBezierPath *path = [UIBezierPath bezierPath];
+            [path moveToPoint:CGPointMake(0, -11)];
+            [path addLineToPoint:CGPointMake(3, -5)];
+            [path addLineToPoint:CGPointMake(2, 2)];
+            [path addLineToPoint:CGPointMake(-2, 2)];
+            [path addLineToPoint:CGPointMake(-3, -5)];
+            [path closePath];
+            [path fill];
+            [[UIBezierPath bezierPathWithRoundedRect:CGRectMake(-5, 2, 10, 2) cornerRadius:1] fill];
+            [[UIBezierPath bezierPathWithRoundedRect:CGRectMake(-1.5, 4, 3, 6) cornerRadius:1] fill];
+        } else {
+            CGSize size = image.size;
+            [image drawAtPoint:CGPointMake((24 - size.width) / 2, (24 - size.height) / 2)];
+        }
+    }];
+}
