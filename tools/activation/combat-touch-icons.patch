+}
+- (void)dragControl:(UIPanGestureRecognizer *)gesture {
+    CGPoint point = [gesture locationInView:self];
+    CGPoint movement = [gesture translationInView:self];
+    if (gesture.state == UIGestureRecognizerStateBegan) {
+        CGPoint start = CGPointMake(point.x - movement.x, point.y - movement.y);
+        _draggedControl = [self btnAt:start];
+        if (_draggedControl < 0) {
+            CGFloat best = 1;
+            _draggedControl = NSIntegerMax;
+            const CGPoint centers[] = {self.faceCenter, self.stickHome, self.dpadCenter};
+            const CGFloat radii[] = {self.faceGap + self.faceHitR, [self stickR:0] * K_STICK_GRAB, self.dpadR * K_DPAD_GRAB};
+            const NSInteger groups[] = {kFaceGroup, kStickGroup, kDpadGroup};
+            for (NSUInteger i = 0; i < (_full ? 3 : 2); ++i) {
+                CGFloat distance = hypot(start.x - centers[i].x, start.y - centers[i].y) / MAX(radii[i], 22);
+                if (distance < best) { best = distance; _draggedControl = groups[i]; }
+            }
+        }
+    }
+    if (_draggedControl == NSIntegerMax || (gesture.state != UIGestureRecognizerStateBegan &&
+        gesture.state != UIGestureRecognizerStateChanged)) return;
+    NSInteger b = _draggedControl;
+    CGPoint center;
+    CGFloat radius;
+    if (b == kFaceGroup) { center = self.faceCenter; radius = self.faceGap + self.faceHitR; }
+    else if (b == kStickGroup) { center = self.stickHome; radius = [self stickR:0]; }
+    else if (b == kDpadGroup) { center = self.dpadCenter; radius = self.dpadR; }
+    else if (isDrop((int)b)) { center = [self dropCenter:(int)b]; radius = [self dropR:(int)b]; }
+    else if (isClick((int)b)) { center = [self clickCenter:(int)b]; radius = K_CLICK_R * self.u; }
+    else {
+        CGRect rect = [self pillRect:(int)b];
+        center = CGPointMake(CGRectGetMidX(rect), CGRectGetMidY(rect));
+        radius = rect.size.width / 2;
+    }
+    CGRect area = self.safe;
+    if (CGRectIsEmpty(area)) return;
+    CGFloat marginX = MIN(radius, area.size.width / 2);
+    CGFloat marginY = MIN(radius, area.size.height / 2);
+    CGFloat x = MIN(MAX(center.x + movement.x, CGRectGetMinX(area) + marginX), CGRectGetMaxX(area) - marginX);
+    CGFloat y = MIN(MAX(center.y + movement.y, CGRectGetMinY(area) + marginY), CGRectGetMaxY(area) - marginY);
+    CGPoint gear = self.menuCenter;
+    if (hypot(x - gear.x, y - gear.y) <= MAX(K_MENU_R * self.u * 1.6, 22) + radius) {
+        [gesture setTranslation:CGPointZero inView:self];
+        return;
+    }
+    _customPositions[[self positionKey:b]] = @[@((x - CGRectGetMinX(area)) / area.size.width),
+                                               @((y - CGRectGetMinY(area)) / area.size.height)];
+    [gesture setTranslation:CGPointZero inView:self];
+    [self setNeedsLayout];
+}
